# Flask Configuration
FLASK_ENV=development
FLASK_APP=backend/app.py
SECRET_KEY=ems-super-secret-key-change-in-production-2026

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ems_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/ems_db
DB_NAME=ems_db

# CORS Configuration
CORS_ORIGIN=*

# Server Port
PORT=5000
